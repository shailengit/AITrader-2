# TradeCraft Environment Configuration
# Copy this file to .env and fill in your actual values

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=5431
DB_NAME=sp1500_1d

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_random_32_byte_hex_string

# CORS Origins (comma-separated, no spaces)
# For development:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# For production:
# CORS_ORIGINS=https://yourdomain.com

# Ports (optional — defaults let this app run alongside AITrader-1, which uses
# 5174 / 8001, without colliding. Override only if you need a different port.)
# Backend port (default 8000):
# PORT=8000
# Frontend port used in CORS allowlist (default 5173):
# FRONTEND_PORT=5173
# Frontend dev-server port (default 5173) and backend proxy target (default
# http://localhost:8000). Set these in the frontend shell, e.g.:
#   VITE_PORT=5175 VITE_API_TARGET=http://localhost:8001 npm run dev
# VITE_PORT=5173
# VITE_API_TARGET=http://localhost:8000

# LLM Configuration
OLLAMA_MODEL=glm-5:cloud
OLLAMA_MODEL_FALLBACK=minimax-m2.5:cloud
LOCAL_LLM_API_BASE=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed

# Finnhub API Key (for earnings calendar sync)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379/0
